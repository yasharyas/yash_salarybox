<?xml version="1.0" encoding="utf-8"?>
<!--
  The capture oval, the same 1.32 ratio the app frames a face with, so the icon,
  the enrolment intro and the camera overlay are all the same mark.

  Everything sits inside the 66dp safe zone centred at (54,54): an adaptive icon
  can be masked to a circle, a squircle or a rounded square, and only that inner
  area is guaranteed to survive.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Ellipse: centre (54,54), rx 17, ry 22.5. Drawn as two half arcs. -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M37,54 A17,22.5 0 1,1 71,54 A17,22.5 0 1,1 37,54 Z" />
</vector>
